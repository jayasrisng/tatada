# Hosted/frontend settings. npm run dev overrides these for the live localhost-only personal runtime.
VITE_ENABLE_BACKEND=false
# Public frontend settings; never put credentials in VITE_* variables.
VITE_BASE_PATH=/tatada/
VITE_API_URL=https://utmbjcgttsjvdpghiqkf.supabase.co/functions/v1/tatada-api
# Events service origin for builds without one on the same host (dev/preview mount /events-api themselves).
# Set only after deploying supabase/functions/tatada-events; it needs no keys.
# VITE_EVENTS_URL=https://utmbjcgttsjvdpghiqkf.supabase.co/functions/v1/tatada-events
# Optional Supabase Edge Function secrets configured in its dashboard:
# TATADA_APP_URL=https://jayasrisng.com/tatada
# TATADA_SECRET=<random 32+ characters; defaults to the private runtime key>
# TATADA_LIVE_RECIPIENTS=you@example.com
# Local Node mode uses APP_URL, PUBLIC_URL, and TATADA_DATA_DIR (.data by default).
# Do not set TATADA_SINGLE_OWNER on public hosting.
# Server-only (never VITE_*): single-owner local Fo access with a Wajo API key.
# WAJO_FO_ENDPOINT=https://mcp.api.wajo.ai/fo
# WAJO_FO_API_KEY=<from Wajo; used only when TATADA_SINGLE_OWNER=1>

# Server-only Claude research (never prefix secrets with VITE_):
# CLAUDE_API_KEY=<your Anthropic key>
# CLAUDE_MODEL=<optional model id; otherwise discover an available Sonnet model>

# Gmail PDF printing: server-only Google OAuth web client credentials.
# Enable the Gmail API and add the exact redirect URI to the Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local preview uses this stable frontend proxy callback, not the ephemeral backend port.
GOOGLE_REDIRECT_URI=http://127.0.0.1:5180/api/gmail/callback

# Optional read-only travel data. Test environment is sample data; production needs provider approval.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
