{
  "name": "tatada",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/test.mjs",
    "server": "node server/index.ts",
    "server:live": "TATADA_FO_MODE=live node server/index.ts",
    "server:fo": "TATADA_FO_MODE=live TATADA_SINGLE_OWNER=1 node server/index.ts",
    "events": "node server/events/serve.ts",
    "dev:lan": "vite --host",
    "predemo": "npm run typecheck && node scripts/predemo.mjs",
    "build:website": "VITE_BASE_PATH=/tatada/ VITE_API_URL=https://utmbjcgttsjvdpghiqkf.supabase.co/functions/v1/tatada-api VITE_EVENTS_URL=https://utmbjcgttsjvdpghiqkf.supabase.co/functions/v1/tatada-events npm run build",
    "check:browser": "node scripts/browser-local.mjs",
    "check:features": "node scripts/check-discovery-history.mjs && node scripts/check-home-import.mjs",
    "check:events-remote": "node scripts/check-events-remote.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "check:stars": "node scripts/check-stars.mjs",
    "check:presentation": "node scripts/check-presentation.mjs",
    "check:print-direct": "node scripts/check-print-direct.mjs",
    "check:journal": "node scripts/check-journal.mjs",
    "check:journey": "node scripts/check-journey.mjs",
    "check:clarity": "node scripts/check-clarity.mjs",
    "check:editing": "node scripts/check-editing.mjs",
    "check:polish": "node scripts/check-polish.mjs",
    "check:compact": "node scripts/check-compact.mjs",
    "check:history": "node scripts/check-history.mjs",
    "check:homebox": "node scripts/check-homebox.mjs",
    "check:policies": "node scripts/check-policies.mjs",
    "dev:offline": "TATADA_PREVIEW_BUILD=1 node scripts/dev.mjs",
    "check:continuation": "node scripts/check-continuation.mjs"
  },
  "dependencies": {
    "@fontsource/cabin-sketch": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@photostructure/tz-lookup": "^11.7.0",
    "d3-geo": "3.1.1",
    "exifr": "^7.1.3",
    "livekit-client": "^2.23.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.0"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}
