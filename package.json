{
  "name": "tatada",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json && tsc -p tsconfig.e2e.json",
    "server": "node server/index.ts",
    "server:live": "TATADA_FO_MODE=live node server/index.ts",
    "server:fo": "TATADA_FO_MODE=live TATADA_SINGLE_OWNER=1 node server/index.ts",
    "events": "node server/events/serve.ts",
    "dev:lan": "vite --host",
    "build:website": "VITE_ENABLE_BACKEND=true VITE_BASE_PATH=/tatada/ VITE_API_URL=https://utmbjcgttsjvdpghiqkf.supabase.co/functions/v1/tatada-api VITE_EVENTS_URL=https://utmbjcgttsjvdpghiqkf.supabase.co/functions/v1/tatada-events npm run build",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:offline": "TATADA_PREVIEW_BUILD=1 node scripts/dev.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs --unit",
    "test:integration": "node scripts/test.mjs --integration",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/cabin-sketch": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@photostructure/tz-lookup": "^11.7.0",
    "@supabase/supabase-js": "2.118.0",
    "d3-geo": "3.1.1",
    "exifr": "^7.1.3",
    "livekit-client": "^2.23.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/d3-geo": "3.1.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.22"
  }
}
