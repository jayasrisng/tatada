{
  "name": "tatada",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/test.mjs",
    "server": "node server/index.ts",
    "server:live": "TATADA_FO_MODE=live node server/index.ts",
    "server:fo": "TATADA_FO_MODE=live TATADA_SINGLE_OWNER=1 node server/index.ts",
    "dev:lan": "vite --host"
  },
  "dependencies": {
    "@fontsource/cabin-sketch": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}
